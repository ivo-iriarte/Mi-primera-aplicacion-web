package views

import (
	sqlc "canchapp/db/sqlc"
	"fmt"
)

templ CanchasPage(deporte sqlc.Deporte, canchas []sqlc.ListCanchasRow) {
	@Layout("Canchas de " + deporte.Nombre) {
		<div class="card">
			<div style="display: flex; justify-content: space-between; align-items: center;">
				<h2>Canchas para { deporte.Nombre }</h2>
				<a href="/app" style="color: var(--primary); text-decoration: none;">← Volver a deportes</a>
			</div>
			if len(canchas) == 0 {
				<p style="margin-top: 1rem; color: #64748b;">No hay canchas registradas para este deporte.</p>
			} else {
				<table>
					<thead>
						<tr>
							<th>Nombre</th>
							<th>Precio</th>
							<th>Duración Turno</th>
							<th>Horario</th>
							<th>Acción</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range canchas {
							<tr>
								<td><strong>{ c.Nombre }</strong></td>
								<td>${ c.Precio }</td>
								<td>{ fmt.Sprintf("%d min", c.DuracionTurnoMinutos) }</td>
								<td>{ fmt.Sprintf("%s - %s", c.HoraApertura, c.HoraCierre) }</td>
								<td>
									<a class="btn-link" href={ templ.SafeURL(fmt.Sprintf("/app/reservas?id_cancha=%d", c.IDCancha)) }>
										Reservar Turno
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}
