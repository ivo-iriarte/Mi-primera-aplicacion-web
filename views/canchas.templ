package views

import (
	sqlc "canchapp/db/sqlc"
	"fmt"
)

templ CanchasPartial(deporte sqlc.Deporte, canchas []sqlc.Cancha) {
	<section class="card">
		<div class="section-header">
			<h2>Canchas para { deporte.Nombre }</h2>
			<a
				class="link-back"
				href="/app"
				hx-get="/app"
				hx-target="#main-content"
				hx-push-url="true"
			>
				← Volver a deportes
			</a>
		</div>
		if len(canchas) == 0 {
			<p class="empty-state">No hay canchas registradas para este deporte.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th scope="col">Nombre</th>
						<th scope="col">Precio</th>
						<th scope="col">Duración Turno</th>
						<th scope="col">Horario</th>
						<th scope="col">Acción</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range canchas {
						<tr>
							<td><strong>{ c.Nombre }</strong></td>
							<td>${ c.Precio }</td>
							<td>{ fmt.Sprintf("%d min", c.DuracionTurnoMinutos) }</td>
							<td>{ fmt.Sprintf("%s - %s", c.HoraApertura, c.HoraCierre) }</td>
							<td>
								<a
									class="btn-link"
									href={ templ.SafeURL(fmt.Sprintf("/app/reservas?id_cancha=%d", c.IDCancha)) }
									hx-get={ fmt.Sprintf("/app/reservas?id_cancha=%d", c.IDCancha) }
									hx-target="#main-content"
									hx-push-url="true"
								>
									Reservar Turno
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

templ CanchasPage(deporte sqlc.Deporte, canchas []sqlc.Cancha) {
	@Layout("Canchas de " + deporte.Nombre) {
		@CanchasPartial(deporte, canchas)
	}
}
