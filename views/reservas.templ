package views

import (
	sqlc "canchapp/db/sqlc"
	"fmt"
)

templ ReservasTabla(reservas []sqlc.Reserva) {
	<div id="contenedor-tabla-reservas">
		if len(reservas) == 0 {
			<p class="empty-state">No hay reservas registradas en el sistema.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th scope="col">ID</th>
						<th scope="col">Cancha</th>
						<th scope="col">Usuario</th>
						<th scope="col">Fecha y Hora</th>
						<th scope="col">Total</th>
						<th scope="col">Acción</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range reservas {
						<tr id={ fmt.Sprintf("reserva-%d", r.IDReserva) }>
							<td>#{ fmt.Sprintf("%d", r.IDReserva) }</td>
							<td>Cancha #{ fmt.Sprintf("%d", r.IDCancha) }</td>
							<td>User #{ fmt.Sprintf("%d", r.IDUsuario) }</td>
							<td>{ r.FechaInicio.Format("02/01/2006 15:04") }</td>
							<td>${ r.PrecioTotal }</td>
							<td>
								<button
									type="button"
									class="btn-danger btn-sm"
									hx-delete={ fmt.Sprintf("/app/reservas/%d", r.IDReserva) }
									hx-target="closest tr"
									hx-swap="outerHTML swap:300ms"
									hx-confirm="¿Seguro que deseás cancelar este turno?"
								>
									Borrar
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ ReservasContent(reservas []sqlc.Reserva, canchas []sqlc.ListCanchasRow, usuarios []sqlc.Usuario, idCanchaPreseleccionada int32) {
	<section class="card">
		<h2>Reservar Turno</h2>
		<div id="reserva-form-container">
			@ReservaForm(canchas, usuarios, idCanchaPreseleccionada)
		</div>
	</section>

	<section class="card">
		<h2>Turnos Reservados</h2>
		@ReservasTabla(reservas)
	</section>
}

templ ReservasPage(reservas []sqlc.Reserva, canchas []sqlc.ListCanchasRow, usuarios []sqlc.Usuario, idCanchaPreseleccionada int32) {
	@Layout("Mis Reservas") {
		@ReservasContent(reservas, canchas, usuarios, idCanchaPreseleccionada)
	}
}
