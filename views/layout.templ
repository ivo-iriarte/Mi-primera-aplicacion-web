package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - CanchApp</title>
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
			<style>
				:root {
					--primary: #0ea5e9;
					--primary-dark: #0284c7;
					--primary-soft: #e0f2fe;
					--primary-text: #0369a1;
					--bg: #f1f5f9;
					--surface: #ffffff;
					--surface-muted: #f8fafc;
					--text: #0f172a;
					--text-muted: #64748b;
					--border: #e2e8f0;
					--success-bg: #dcfce7;
					--success-text: #166534;
					--danger: #ef4444;
					--danger-dark: #dc2626;
					--danger-bg: #fee2e2;
					--danger-text: #991b1b;
					--radius-sm: 10px;
					--radius: 16px;
					--shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
					--shadow-hover: 0 8px 20px rgba(14, 165, 233, 0.14);
				}
				* { box-sizing: border-box; margin: 0; padding: 0; }
				body {
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
					background-color: var(--bg);
					color: var(--text);
					line-height: 1.5;
					min-height: 100vh;
				}
				.topbar {
					background-color: var(--surface);
					border-bottom: 1px solid var(--border);
					position: sticky;
					top: 0;
					z-index: 20;
				}
				.topbar-inner {
					max-width: 960px;
					margin: 0 auto;
					padding: 0.9rem 1.25rem;
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 1rem;
				}
				.brand {
					color: var(--text);
					text-decoration: none;
					font-size: 1.35rem;
					font-weight: 800;
					letter-spacing: -0.02em;
					display: flex;
					align-items: center;
					gap: 0.45rem;
				}
				.brand-dot {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					width: 2rem;
					height: 2rem;
					border-radius: 9999px;
					background: var(--primary-soft);
					color: var(--primary-dark);
					font-size: 1rem;
				}
				.nav-links {
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}
				.nav-link {
					color: var(--text-muted);
					text-decoration: none;
					font-weight: 600;
					font-size: 0.92rem;
					padding: 0.45rem 0.9rem;
					border-radius: 9999px;
					transition: background-color 0.15s, color 0.15s;
				}
				.nav-link:hover {
					background-color: var(--primary-soft);
					color: var(--primary-dark);
				}
				.page-shell {
					max-width: 960px;
					margin: 1.75rem auto 3rem;
					padding: 0 1.25rem;
				}
				.hero-card {
					background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
					border: 1px solid var(--border);
					border-radius: var(--radius);
					padding: 1.5rem 1.75rem;
					margin-bottom: 1.5rem;
					box-shadow: var(--shadow);
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 1rem;
					flex-wrap: wrap;
				}
				.hero-greeting {
					color: var(--text-muted);
					font-size: 0.9rem;
					font-weight: 500;
				}
				.hero-title {
					font-size: 1.55rem;
					font-weight: 800;
					margin-top: 0.15rem;
				}
				.hero-subtitle {
					color: var(--text-muted);
					margin-top: 0.25rem;
					font-size: 0.95rem;
				}
				.card {
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: var(--radius);
					padding: 1.35rem 1.5rem;
					margin-bottom: 1.25rem;
					box-shadow: var(--shadow);
				}
				.section-header {
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 1rem;
					margin-bottom: 1rem;
					flex-wrap: wrap;
				}
				.back-link {
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
					color: var(--primary-dark);
					background: var(--surface);
					border: 1px solid var(--border);
					padding: 0.4rem 0.85rem;
					border-radius: 9999px;
					text-decoration: none;
					font-size: 0.88rem;
					font-weight: 600;
					margin-bottom: 1rem;
				}
				.back-link:hover {
					background: var(--primary-soft);
					border-color: #bae6fd;
				}
				.sports-grid {
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
					gap: 1rem;
				}
				.sport-card {
					display: flex;
					flex-direction: column;
					align-items: center;
					text-align: center;
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: var(--radius);
					padding: 1.5rem 1rem;
					text-decoration: none;
					color: var(--text);
					box-shadow: var(--shadow);
					transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
				}
				.sport-card:hover {
					transform: translateY(-2px);
					box-shadow: var(--shadow-hover);
					border-color: #7dd3fc;
				}
				.sport-icon-circle {
					width: 4.25rem;
					height: 4.25rem;
					border-radius: 9999px;
					background: var(--primary-soft);
					display: flex;
					align-items: center;
					justify-content: center;
					font-size: 2rem;
					margin-bottom: 0.85rem;
				}
				.sport-name {
					font-size: 1.15rem;
					font-weight: 700;
					margin-bottom: 0.45rem;
				}
				.pill {
					display: inline-flex;
					align-items: center;
					gap: 0.25rem;
					padding: 0.25rem 0.65rem;
					border-radius: 9999px;
					font-size: 0.78rem;
					font-weight: 600;
					background-color: var(--primary-soft);
					color: var(--primary-text);
					text-decoration: none;
				}
				.pill-muted {
					background-color: #f1f5f9;
					color: #475569;
				}
				.pill-active {
					background-color: var(--primary);
					color: #ffffff;
				}
				.pill-success {
					background-color: var(--success-bg);
					color: var(--success-text);
				}
				.pill-cancelled {
					background-color: #f1f5f9;
					color: #64748b;
				}
				.filter-pills {
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem;
					margin: 0.75rem 0 1.25rem;
				}
				.list-stack {
					display: flex;
					flex-direction: column;
					gap: 1rem;
				}
				.inst-card {
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 1rem;
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: var(--radius);
					padding: 1.25rem 1.4rem;
					text-decoration: none;
					color: var(--text);
					box-shadow: var(--shadow);
					transition: border-color 0.15s ease, box-shadow 0.15s ease;
				}
				.inst-card:hover {
					border-color: #7dd3fc;
					box-shadow: var(--shadow-hover);
				}
				.inst-avatar {
					width: 3.5rem;
					height: 3.5rem;
					border-radius: 14px;
					background: var(--primary-soft);
					color: var(--primary-dark);
					display: flex;
					align-items: center;
					justify-content: center;
					font-size: 1.5rem;
					flex-shrink: 0;
				}
				.cancha-card {
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: var(--radius);
					padding: 1.35rem 1.5rem;
					box-shadow: var(--shadow);
				}
				.cancha-top {
					display: flex;
					justify-content: space-between;
					align-items: flex-start;
					gap: 1rem;
				}
				.price-tag {
					text-align: right;
				}
				.price-amount {
					font-size: 1.35rem;
					font-weight: 800;
					color: var(--text);
				}
				.price-unit {
					font-size: 0.78rem;
					color: var(--text-muted);
				}
				.services-row {
					display: flex;
					flex-wrap: wrap;
					gap: 0.45rem;
					margin-top: 0.85rem;
				}
				.cancha-footer {
					margin-top: 1rem;
					padding-top: 0.85rem;
					border-top: 1px solid var(--border);
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 0.75rem;
					flex-wrap: wrap;
				}
				.days-strip {
					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(76px, 1fr));
					gap: 0.6rem;
					margin: 0.85rem 0 1rem;
				}
				.day-chip {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 0.65rem 0.4rem;
					border-radius: 14px;
					border: 1px solid var(--border);
					background: var(--surface);
					color: var(--text);
					text-decoration: none;
					transition: border-color 0.15s, background-color 0.15s;
				}
				.day-chip:hover {
					border-color: var(--primary);
				}
				.day-chip-active {
					background: var(--primary);
					border-color: var(--primary);
					color: #ffffff;
				}
				.day-chip-dow {
					font-size: 0.72rem;
					font-weight: 700;
					opacity: 0.85;
				}
				.day-chip-num {
					font-size: 1.2rem;
					font-weight: 800;
					line-height: 1.2;
				}
				/* Grilla de horarios disponibles sin JavaScript usando radio inputs nativos */
				.slots-grid {
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
					gap: 0.65rem;
					margin: 0.85rem 0 1.25rem;
				}
				.slot-chip {
					position: relative;
					display: block;
					cursor: pointer;
				}
				.slot-chip input[type="radio"] {
					position: absolute;
					opacity: 0;
					pointer-events: none;
				}
				.slot-chip-box {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 0.7rem 0.5rem;
					border: 1.5px solid var(--border);
					border-radius: 12px;
					background: var(--surface);
					font-weight: 700;
					font-size: 0.92rem;
					color: var(--text);
					transition: all 0.12s ease;
				}
				.slot-chip:hover .slot-chip-box {
					border-color: var(--primary);
					background: #f0f9ff;
				}
				.slot-chip input[type="radio"]:checked + .slot-chip-box {
					background: var(--primary);
					border-color: var(--primary);
					color: #ffffff;
					box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
				}
				.slot-chip input[type="radio"]:focus-visible + .slot-chip-box {
					outline: 2px solid var(--primary-dark);
					outline-offset: 2px;
				}
				.slot-ocupado {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 0.7rem 0.5rem;
					border: 1px dashed #cbd5e1;
					border-radius: 12px;
					background: #f8fafc;
					color: #94a3b8;
					font-size: 0.88rem;
					text-decoration: line-through;
					cursor: not-allowed;
				}
				.slot-ocupado small {
					text-decoration: none;
					font-size: 0.7rem;
					font-weight: 600;
				}
				.tabs-bar {
					display: flex;
					border-bottom: 2px solid var(--border);
					margin-bottom: 1.25rem;
					gap: 0.5rem;
				}
				.tab-link {
					padding: 0.65rem 1.25rem;
					text-decoration: none;
					font-weight: 700;
					font-size: 0.95rem;
					color: var(--text-muted);
					border-bottom: 2px solid transparent;
					margin-bottom: -2px;
				}
				.tab-link-active {
					color: var(--primary-dark);
					border-bottom-color: var(--primary);
				}
				.form-grid {
					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
					gap: 0.9rem;
					align-items: end;
				}
				.field-label {
					display: block;
					font-size: 0.82rem;
					font-weight: 600;
					color: var(--text-muted);
					margin-bottom: 0.3rem;
				}
				input[type="text"], input[type="date"], select {
					width: 100%;
					padding: 0.6rem 0.8rem;
					border: 1px solid var(--border);
					border-radius: var(--radius-sm);
					font-size: 0.94rem;
					background: var(--surface);
					color: var(--text);
				}
				button, .btn-primary {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: 0.35rem;
					background-color: var(--primary);
					color: #ffffff;
					border: none;
					padding: 0.65rem 1.2rem;
					border-radius: 9999px;
					font-weight: 700;
					font-size: 0.92rem;
					text-decoration: none;
					cursor: pointer;
					transition: background-color 0.15s;
				}
				button:hover, .btn-primary:hover {
					background-color: var(--primary-dark);
				}
				button:disabled {
					background-color: #cbd5e1;
					cursor: not-allowed;
				}
				.btn-outline-danger {
					background-color: transparent;
					color: var(--danger);
					border: 1.5px solid #fca5a5;
					padding: 0.5rem 1rem;
					border-radius: 9999px;
					font-weight: 700;
					font-size: 0.86rem;
				}
				.btn-outline-danger:hover {
					background-color: var(--danger-bg);
					color: var(--danger-dark);
				}
				.btn-secondary {
					background-color: var(--primary-soft);
					color: var(--primary-dark);
				}
				.btn-secondary:hover {
					background-color: #bae6fd;
				}
				.htmx-indicator {
					display: none;
					font-size: 0.85rem;
					color: var(--primary-dark);
					font-weight: 600;
				}
				.htmx-request .htmx-indicator,
				.htmx-request.htmx-indicator {
					display: inline-block;
				}
				.alert {
					padding: 0.85rem 1.1rem;
					border-radius: var(--radius-sm);
					margin-bottom: 1.1rem;
					font-size: 0.92rem;
					font-weight: 600;
				}
				.alert-success {
					background-color: var(--success-bg);
					color: var(--success-text);
					border: 1px solid #bbf7d0;
				}
				.alert-error {
					background-color: var(--danger-bg);
					color: var(--danger-text);
					border: 1px solid #fecaca;
				}
				details.admin-box {
					margin-top: 1.5rem;
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: var(--radius-sm);
					padding: 0.85rem 1.1rem;
				}
				details.admin-box summary {
					cursor: pointer;
					font-weight: 600;
					font-size: 0.9rem;
					color: var(--text-muted);
				}
			</style>
		</head>
		<body>
			<header class="topbar">
				<div class="topbar-inner">
					<a
						class="brand"
						href="/app"
						hx-get="/app"
						hx-target="#main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
					>
						<span class="brand-dot">⚽</span>
						<span>CanchApp</span>
					</a>
					<nav class="nav-links">
						<a
							class="nav-link"
							href="/app"
							hx-get="/app"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
						>
							Inicio
						</a>
						<a
							class="nav-link"
							href="/app/reservas"
							hx-get="/app/reservas"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
						>
							Mis Reservas
						</a>
					</nav>
				</div>
			</header>
			<main class="page-shell">
				<div id="toast-container"></div>
				<div id="main-content">
					{ children... }
				</div>
			</main>
		</body>
	</html>
}

// FlashMessage renderiza notificaciones al usuario y soporta Out-of-Band Swap (hx-swap-oob="true").
templ FlashMessage(mensaje string, tipo string, oob bool) {
	if oob {
		<div id="toast-container" hx-swap-oob="true">
			if mensaje != "" {
				<div class={ "alert", templ.KV("alert-success", tipo == "success"), templ.KV("alert-error", tipo == "error") }>
					{ mensaje }
				</div>
			}
		</div>
	} else if mensaje != "" {
		<div class={ "alert", templ.KV("alert-success", tipo == "success"), templ.KV("alert-error", tipo == "error") }>
			{ mensaje }
		</div>
	}
}
