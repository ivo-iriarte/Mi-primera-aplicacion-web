package views

import (
	sqlc "canchapp/db/sqlc"
	"fmt"
)

templ DeportesGrid(deportes []sqlc.Deporte) {
	<div id="lista-deportes">
		if len(deportes) == 0 {
			<p class="empty-state">No hay deportes disponibles.</p>
		} else {
			<div class="grid">
				for _, d := range deportes {
					<article class="card deporte-card" id={ fmt.Sprintf("deporte-%d", d.IDDeporte) }>
						<div>
							<h3>{ d.Nombre }</h3>
							<span class="badge">
								if d.Activo {
									Activo
								} else {
									Inactivo
								}
							</span>
						</div>
						<div class="deporte-card-actions">
							<a
								class="btn-link"
								href={ templ.SafeURL(fmt.Sprintf("/app/deportes/%d/canchas", d.IDDeporte)) }
								hx-get={ fmt.Sprintf("/app/deportes/%d/canchas", d.IDDeporte) }
								hx-target="#main-content"
								hx-push-url="true"
							>
								Ver Canchas →
							</a>
							<button
								type="button"
								class="btn-danger btn-sm"
								hx-delete={ fmt.Sprintf("/app/deportes/%d", d.IDDeporte) }
								hx-target="closest .deporte-card"
								hx-swap="outerHTML swap:300ms"
								hx-confirm="¿Estás seguro de que deseás eliminar este deporte?"
							>
								Eliminar
							</button>
						</div>
					</article>
				}
			</div>
		}
	</div>
}

templ DeportesContent(deportes []sqlc.Deporte) {
	<section class="card">
		<h2>Deportes Disponibles</h2>
		<p>Seleccioná un deporte para ver las canchas asociadas.</p>
		@DeportesGrid(deportes)
	</section>

	<section class="card">
		<h3>Registrar Nuevo Deporte</h3>
		<div id="deporte-form-container">
			@DeporteForm()
		</div>
	</section>
}

templ DeportesPage(deportes []sqlc.Deporte) {
	@Layout("Deportes Disponibles") {
		@DeportesContent(deportes)
	}
}
