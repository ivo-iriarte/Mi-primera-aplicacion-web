package views

import (
	sqlc "canchapp/db/sqlc"
	"fmt"
)

templ DeportesGrid(deportes []sqlc.Deporte) {
	<div id="lista-deportes">
		if len(deportes) == 0 {
			<p style="margin-top: 1rem; color: #64748b;">No hay deportes disponibles.</p>
		} else {
			<div class="grid">
				for _, d := range deportes {
					<div class="card" style="margin-bottom: 0;">
						<h3>{ d.Nombre }</h3>
						<span class="badge" style="margin: 0.5rem 0;">
							if d.Activo {
								Activo
							} else {
								Inactivo
							}
						</span>
						<div>
							<a
								class="btn-link"
								href={ templ.SafeURL(fmt.Sprintf("/app/deportes/%d/canchas", d.IDDeporte)) }
								hx-get={ fmt.Sprintf("/app/deportes/%d/canchas", d.IDDeporte) }
								hx-target="#main-content"
								hx-push-url="true"
							>
								Ver Canchas →
							</a>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

templ DeportesPage(deportes []sqlc.Deporte) {
	@Layout("Deportes Disponibles") {
		<div class="card">
			<h2>Deportes Disponibles</h2>
			<p>Seleccioná un deporte para ver las canchas asociadas.</p>
			@DeportesGrid(deportes)
		</div>

		<div class="card">
			<h3>Registrar Nuevo Deporte</h3>
			<form
				action="/app/deportes/crear"
				method="POST"
				hx-post="/app/deportes/crear"
				hx-target="#lista-deportes"
				hx-swap="outerHTML"
				hx-indicator="#spinner-deporte"
				hx-on::after-request="if(event.detail.successful) this.reset()"
			>
				<input type="text" name="nombre" placeholder="Nombre (ej. Basquet)" required/>
				<button type="submit">Guardar</button>
				<span id="spinner-deporte" class="htmx-indicator">Guardando...</span>
			</form>
		</div>
	}
}
